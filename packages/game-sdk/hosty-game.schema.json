{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hosty.app/schemas/hosty-game.v1.json",
  "title": "Hosty game pack manifest (apiVersion 1)",
  "type": "object",
  "required": [
    "apiVersion",
    "id",
    "name",
    "version",
    "defaults",
    "launch"
  ],
  "additionalProperties": false,
  "$defs": {
    "localized": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "platformValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "win32": {
              "type": "string"
            },
            "linux": {
              "type": "string"
            },
            "darwin": {
              "type": "string"
            },
            "default": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "patterns": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\]|[A-Za-z]:)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+$"
    }
  },
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint: path or URL of this schema."
    },
    "apiVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "logo": {
      "$ref": "#/$defs/relativePath"
    },
    "description": {
      "$ref": "#/$defs/localized"
    },
    "badge": {
      "type": "string",
      "maxLength": 4
    },
    "category": {
      "enum": [
        "voxel",
        "survival",
        "sandbox"
      ]
    },
    "status": {
      "enum": [
        "available",
        "beta",
        "coming_soon"
      ]
    },
    "defaults": {
      "type": "object",
      "required": [
        "port",
        "maxPlayers"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "maxPlayers": {
          "type": "integer",
          "minimum": 1
        },
        "memoryMb": {
          "type": "integer",
          "minimum": 256
        }
      },
      "additionalProperties": false
    },
    "provision": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "none"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "appId"
          ],
          "properties": {
            "type": {
              "const": "steamcmd"
            },
            "appId": {
              "type": "integer"
            },
            "branchField": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "url"
          ],
          "properties": {
            "type": {
              "const": "download"
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "filename": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "launch": {
      "type": "object",
      "required": [
        "executable"
      ],
      "properties": {
        "runtime": {
          "enum": [
            "native",
            "java"
          ]
        },
        "executable": {
          "$ref": "#/$defs/platformValue"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "discover": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "glob"
            ],
            "additionalProperties": false,
            "properties": {
              "glob": {
                "type": "string"
              },
              "platform": {
                "enum": [
                  "win32",
                  "linux",
                  "darwin"
                ]
              },
              "exclude": {
                "type": "string"
              },
              "mode": {
                "enum": [
                  "args",
                  "jar"
                ]
              },
              "args": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "arg",
                        "ifExists"
                      ],
                      "properties": {
                        "arg": {
                          "type": "string"
                        },
                        "ifExists": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "detect": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "logs": {
      "type": "object",
      "properties": {
        "ready": {
          "$ref": "#/$defs/patterns"
        },
        "join": {
          "$ref": "#/$defs/patterns"
        },
        "leave": {
          "$ref": "#/$defs/patterns"
        },
        "dimension": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "properties": {
        "stop": {
          "type": "string"
        },
        "save": {
          "type": [
            "string",
            "null"
          ]
        },
        "listPlayers": {
          "type": "string",
          "description": "Console command that prints who is online (offered as \"refresh list\")."
        },
        "broadcast": {
          "type": "string",
          "description": "Console command announcing {{message}} to every player (used before scheduled restarts)."
        }
      },
      "additionalProperties": false
    },
    "configFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "format"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "format": {
            "enum": [
              "properties",
              "ini",
              "json",
              "toml",
              "lines"
            ]
          },
          "label": {
            "$ref": "#/$defs/localized"
          }
        },
        "additionalProperties": false
      }
    },
    "setup": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "select",
              "text",
              "secret",
              "number",
              "toggle",
              "custom"
            ]
          },
          "label": {
            "$ref": "#/$defs/localized"
          },
          "description": {
            "$ref": "#/$defs/localized"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "label"
              ],
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "$ref": "#/$defs/localized"
                }
              }
            }
          },
          "default": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "component": {
            "type": "string"
          },
          "labelKey": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "players": {
          "type": "boolean"
        },
        "mods": {
          "type": "boolean"
        },
        "configEditor": {
          "type": "boolean"
        },
        "bridge": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "modFormat": {
      "type": "string"
    },
    "i18n": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "playerQueries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "command",
          "pattern",
          "fields"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "number",
                "string"
              ]
            }
          }
        }
      }
    },
    "configSync": {
      "type": "object",
      "required": [
        "file",
        "format",
        "map"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "format": {
          "enum": [
            "properties",
            "ini",
            "json",
            "toml"
          ]
        },
        "map": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "string"
            },
            "motd": {
              "type": "string"
            },
            "maxPlayers": {
              "type": "string"
            }
          }
        }
      }
    },
    "bridgeLoaders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "jvmFlagPresets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "description",
          "flags"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendedFor": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "serverIcon": {
      "type": "object",
      "description": "Icon the game itself shows (e.g. its server list). Omit it when the game has none: the icon is then only shown inside Hosty.",
      "required": [
        "file",
        "size"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "pattern": "\\.png$",
          "description": "PNG path relative to the instance folder."
        },
        "size": {
          "type": "integer",
          "minimum": 16,
          "maximum": 1024,
          "description": "Exact width and height in pixels."
        }
      }
    },
    "modSources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "baseUrl"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "modrinth"
            ]
          },
          "baseUrl": {
            "type": "string"
          },
          "projectUrl": {
            "type": "string"
          },
          "loaderCategories": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "projectTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "installDir": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "defaultInstallDir": {
            "type": "string"
          }
        }
      }
    },
    "modLayout": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the Mods tabs look and which files are mods.",
      "properties": {
        "modsDir": {
          "$ref": "#/$defs/relativePath"
        },
        "configDir": {
          "$ref": "#/$defs/relativePath"
        },
        "fileTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extensions of mod files (e.g. \".jar\"); empty = any file."
        }
      }
    },
    "extension": {
      "type": "string",
      "description": "Reserved for packs bundled with Hosty."
    },
    "playerActions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "$ref": "#/$defs/localized"
          },
          "command": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            ],
            "description": "Console command(s); {{player}} and {{<param id>}} are replaced. Used unless the bridge runs bridgeAction."
          },
          "danger": {
            "type": "boolean"
          },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "$ref": "#/$defs/localized"
                },
                "type": {
                  "enum": [
                    "text",
                    "number",
                    "select"
                  ]
                },
                "default": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "value",
                      "label"
                    ],
                    "properties": {
                      "value": {
                        "type": "string"
                      },
                      "label": {
                        "$ref": "#/$defs/localized"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            }
          },
          "bridgeAction": {
            "type": "string",
            "description": "Telemetry Bridge action used instead of command when the bridge is connected and advertises it. Param values are sent under their ids."
          },
          "quick": {
            "type": "boolean",
            "description": "Shown as a button on each player card and in the Overview."
          },
          "icon": {
            "enum": [
              "ban",
              "cloud-lightning",
              "gamepad",
              "gift",
              "heart",
              "map-pin",
              "message",
              "package",
              "shield",
              "shield-off",
              "skull",
              "snowflake",
              "sparkles",
              "star",
              "sun",
              "trash",
              "user-x",
              "users",
              "utensils",
              "volume-2",
              "volume-x",
              "zap"
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "command"
            ]
          },
          {
            "required": [
              "bridgeAction"
            ]
          }
        ]
      }
    },
    "quickCommands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "command"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "command": {
            "type": "string"
          }
        }
      }
    },
    "playerView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "type": "boolean"
        },
        "coordinates": {
          "type": "boolean"
        },
        "vitals": {
          "type": "boolean"
        },
        "avatarUrl": {
          "type": "string"
        },
        "itemIconUrls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Inventory item image URL templates tried in order ({{item}}, {{namespace}})."
        },
        "itemNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Item namespaces the image templates cover; other items show their initials."
        },
        "inventoryClearAction": {
          "type": "string",
          "description": "Id of the player action that empties an inventory (offered in the inventory viewer)."
        }
      }
    },
    "dimensions": {
      "type": "array",
      "description": "Worlds/dimensions players can be in: filter chips, labels and icons.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "$ref": "#/$defs/localized"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "icon": {
            "$ref": "#/$defs/relativePath"
          },
          "primary": {
            "type": "boolean",
            "description": "Listed as a filter chip even when nobody is there."
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "required": [
        "tickRate"
      ],
      "additionalProperties": false,
      "properties": {
        "tickRate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Ticks per second the server targets; enables the TPS card when the bridge reports TPS."
        }
      }
    },
    "motd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colorCodes": {
          "type": "boolean",
          "description": "§ / & formatting codes in the MOTD."
        },
        "preview": {
          "type": "boolean",
          "description": "Server-list style preview with the server icon."
        }
      }
    },
    "devMock": {
      "$ref": "#/$defs/relativePath",
      "description": "Development only: JSON with sample players / inventory for simulated telemetry."
    },
    "installer": {
      "type": "object",
      "required": [
        "variants"
      ],
      "additionalProperties": false,
      "description": "Bundled packs whose extension implements an installer: variants offered by the generic installer step.",
      "properties": {
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "automatic"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "group": {
                "$ref": "#/$defs/localized"
              },
              "automatic": {
                "type": "boolean"
              },
              "url": {
                "type": "string"
              }
            }
          }
        },
        "defaultVariant": {
          "type": "string"
        },
        "fileTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "javaRequirements": {
          "type": "object",
          "required": [
            "default",
            "versions"
          ],
          "additionalProperties": false,
          "properties": {
            "default": {
              "type": "integer"
            },
            "versions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "from",
                  "java"
                ],
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "java": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "creationSettings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "type",
          "file",
          "key"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "$ref": "#/$defs/localized"
          },
          "type": {
            "enum": [
              "select",
              "text",
              "number"
            ]
          },
          "default": {
            "type": [
              "string",
              "number"
            ]
          },
          "file": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "label"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "$ref": "#/$defs/localized"
                }
              }
            }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "required": [
        "paths"
      ],
      "additionalProperties": false,
      "description": "Paths (relative to the instance) a backup contains. Without it the whole instance is zipped.",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    }
  }
}
