{
  "name": "@hosty/game-sdk",
  "version": "0.1.0",
  "description": "Types and helpers to build Hosty game packs (hosty-game.json) and optional driver.js extensions.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "hosty-game.schema.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "sync-validator": "node scripts/sync-validator.js",
    "prepublishOnly": "npm run sync-validator && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0"
  },
  "bin": {
    "hosty-pack": "bin/hosty-pack.js"
  }
}
