{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hosty",
  "version": "0.1.2",
  "identifier": "com.hosty.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Hosty",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGRkQ3MkY4NjQxN0U0QjMKUldTejVCZGsrSEw5VDI0YXJVbEJodG5RTXBDSVFmdWpQWGVsaitObTZnM1hhMkJjbHlaSUtYckUK",
      "endpoints": [
        "https://github.com/Morphy137/Hosty/releases/latest/download/latest.json"
      ]
    }
  }
}
