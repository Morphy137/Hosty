{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hosty",
  "version": "0.2.1",
  "identifier": "com.hosty.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Hosty",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: http://127.0.0.1:* http://localhost:* https://mc-heads.net https://assets.mcasset.cloud; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https://meta.fabricmc.net https://piston-meta.mojang.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "displayLanguageSelector": true,
        "languages": ["English", "SpanishInternational", "Spanish", "PortugueseBR", "Portuguese", "SimpChinese"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/hosty-daemon"
    ],
    "resources": {
      "../../daemon/assets/bridge/": "bridge/",
      "../../daemon/assets/locales/": "locales/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGRkQ3MkY4NjQxN0U0QjMKUldTejVCZGsrSEw5VDI0YXJVbEJodG5RTXBDSVFmdWpQWGVsaitObTZnM1hhMkJjbHlaSUtYckUK",
      "endpoints": [
        "https://github.com/Morphy137/Hosty/releases/latest/download/latest.json"
      ]
    }
  }
}
