{
  "apiVersion": 1,
  "id": "project-zomboid",
  "name": "Project Zomboid",
  "version": "1.0.0",
  "badge": "PZ",
  "category": "survival",
  "status": "beta",
  "description": {
    "en": "Project Zomboid Dedicated Server (SteamCMD AppID 380870)",
    "es": "Servidor dedicado de Project Zomboid (SteamCMD AppID 380870)"
  },
  "defaults": {
    "port": 16261,
    "maxPlayers": 32
  },
  "provision": {
    "type": "steamcmd",
    "appId": 380870
  },
  "launch": {
    "runtime": "native",
    "executable": {
      "win32": "ProjectZomboid64.exe|StartServer64.bat",
      "default": "start-server.sh"
    },
    "args": [
      "-servername",
      "servertest",
      "-memory",
      "{{maxRamMb}}m",
      "-port",
      "{{port}}"
    ]
  },
  "detect": [
    "ProjectZomboid64.exe",
    "StartServer64.bat",
    "start-server.sh",
    "ProjectZomboid64.json",
    "servertest.ini"
  ],
  "logs": {
    "ready": [
      "SERVER STARTED",
      "Server is now listening on port",
      "Steam game server initialized"
    ],
    "join": [
      "user\\s+\"?(?<username>[^\"\\s]+)\"?\\s+is connected",
      "Player\\s+\"?(?<username>[^\"\\s]+)\"?\\s+connected",
      "\\*\\*\\*\\s+Player\\s+(?<username>[^\\s]+)\\s+connected"
    ],
    "leave": [
      "user\\s+\"?(?<username>[^\"\\s]+)\"?\\s+disconnected",
      "Player\\s+\"?(?<username>[^\"\\s]+)\"?\\s+disconnected",
      "\\*\\*\\*\\s+Player\\s+(?<username>[^\\s]+)\\s+disconnected"
    ],
    "dimension": "knox_county"
  },
  "commands": {
    "stop": "quit",
    "save": "save"
  },
  "configFiles": [
    {
      "path": "servertest.ini",
      "format": "ini"
    }
  ],
  "setup": [
    {
      "id": "pzBranch",
      "type": "select",
      "label": {
        "en": "SteamCMD branch",
        "es": "Rama de SteamCMD"
      },
      "default": "stable",
      "options": [
        {
          "value": "stable",
          "label": {
            "en": "Public release (Build 41+)",
            "es": "Versión pública (Build 41+)"
          }
        },
        {
          "value": "unstable",
          "label": {
            "en": "Unstable / Beta branch",
            "es": "Rama inestable / Beta"
          }
        }
      ]
    }
  ],
  "capabilities": {
    "players": true,
    "mods": true,
    "configEditor": true,
    "bridge": false
  },
  "modFormat": "Steam Workshop / Lua",
  "logo": "logo.webp"
}
