{
  "apiVersion": 1,
  "id": "minecraft",
  "name": "Minecraft: Java Edition",
  "version": "1.0.0",
  "badge": "MC",
  "category": "voxel",
  "status": "available",
  "description": {
    "en": "Official Mojang, Fabric, Paper, Forge and NeoForge Java servers"
  },
  "defaults": {
    "port": 25565,
    "maxPlayers": 20,
    "memoryMb": 4096
  },
  "launch": {
    "runtime": "java",
    "executable": "server.jar",
    "args": [
      "nogui"
    ],
    "discover": [
      {
        "glob": "libraries/net/neoforged/neoforge/*/win_args.txt",
        "platform": "win32",
        "args": [
          {
            "arg": "@user_jvm_args.txt",
            "ifExists": "user_jvm_args.txt"
          },
          "@{{match}}",
          "nogui"
        ]
      },
      {
        "glob": "libraries/net/neoforged/neoforge/*/unix_args.txt",
        "platform": "linux",
        "args": [
          {
            "arg": "@user_jvm_args.txt",
            "ifExists": "user_jvm_args.txt"
          },
          "@{{match}}",
          "nogui"
        ]
      },
      {
        "glob": "libraries/net/neoforged/neoforge/*/unix_args.txt",
        "platform": "darwin",
        "args": [
          {
            "arg": "@user_jvm_args.txt",
            "ifExists": "user_jvm_args.txt"
          },
          "@{{match}}",
          "nogui"
        ]
      },
      {
        "glob": "libraries/net/minecraftforge/forge/*/win_args.txt",
        "platform": "win32",
        "args": [
          {
            "arg": "@user_jvm_args.txt",
            "ifExists": "user_jvm_args.txt"
          },
          "@{{match}}",
          "nogui"
        ]
      },
      {
        "glob": "libraries/net/minecraftforge/forge/*/unix_args.txt",
        "platform": "linux",
        "args": [
          {
            "arg": "@user_jvm_args.txt",
            "ifExists": "user_jvm_args.txt"
          },
          "@{{match}}",
          "nogui"
        ]
      },
      {
        "glob": "libraries/net/minecraftforge/forge/*/unix_args.txt",
        "platform": "darwin",
        "args": [
          {
            "arg": "@user_jvm_args.txt",
            "ifExists": "user_jvm_args.txt"
          },
          "@{{match}}",
          "nogui"
        ]
      },
      {
        "glob": "forge-*.jar",
        "exclude": "installer",
        "mode": "jar",
        "args": [
          "nogui"
        ]
      }
    ]
  },
  "detect": [
    "server.properties"
  ],
  "logs": {
    "ready": "Done \\([\\d.,]+s\\)! For help, type \"help\"",
    "join": ":\\s(?<username>[a-zA-Z0-9_]{3,16}) joined the game",
    "leave": ":\\s(?<username>[a-zA-Z0-9_]{3,16}) left the game"
  },
  "commands": {
    "stop": "stop",
    "save": "save-all"
  },
  "playerQueries": [
    {
      "id": "Pos",
      "command": "data get entity {{player}} Pos",
      "pattern": ":\\s(?<username>[a-zA-Z0-9_]{3,16}) has the following entity data: \\[(?<x>-?\\\\d+(?:\\\\.\\\\d+)?(?:E-?\\\\d+)?)d, (?<y>-?\\\\d+(?:\\\\.\\\\d+)?(?:E-?\\\\d+)?)d, (?<z>-?\\\\d+(?:\\\\.\\\\d+)?(?:E-?\\\\d+)?)d\\]",
      "fields": {
        "x": "number",
        "y": "number",
        "z": "number"
      }
    },
    {
      "id": "Dimension",
      "command": "data get entity {{player}} Dimension",
      "pattern": ":\\s(?<username>[a-zA-Z0-9_]{3,16}) has the following entity data: \"(?:[a-z0-9_.-]+:)?(?<dimension>[a-z0-9_./-]+)\"",
      "fields": {
        "dimension": "string"
      }
    }
  ],
  "configFiles": [
    {
      "path": "server.properties",
      "format": "properties"
    }
  ],
  "configSync": {
    "file": "server.properties",
    "format": "properties",
    "map": {
      "port": "server-port",
      "motd": "motd",
      "maxPlayers": "max-players"
    }
  },
  "bridgeLoaders": [
    "paper",
    "purpur",
    "spigot",
    "fabric"
  ],
  "setup": [
    {
      "id": "install",
      "type": "custom",
      "label": "Installation",
      "labelKey": "create_server.steps.installation",
      "component": "minecraft-install"
    }
  ],
  "capabilities": {
    "players": true,
    "mods": true,
    "configEditor": true,
    "bridge": true
  },
  "modFormat": "JAR (.jar)",
  "jvmFlagPresets": [
    {
      "id": "aikar",
      "label": "Aikar's flags",
      "description": "Tuned G1GC set for Paper-family servers with 4 GB or more. Best for Paper, Purpur and Spigot.",
      "flags": [
        "-XX:+UseG1GC",
        "-XX:+ParallelRefProcEnabled",
        "-XX:MaxGCPauseMillis=200",
        "-XX:+UnlockExperimentalVMOptions",
        "-XX:+DisableExplicitGC",
        "-XX:+AlwaysPreTouch",
        "-XX:G1NewSizePercent=30",
        "-XX:G1MaxNewSizePercent=40",
        "-XX:G1HeapRegionSize=8M",
        "-XX:G1ReservePercent=20",
        "-XX:G1HeapWastePercent=5",
        "-XX:G1MixedGCCountTarget=4",
        "-XX:InitiatingHeapOccupancyPercent=15",
        "-XX:G1MixedGCLiveThresholdPercent=90",
        "-XX:G1RSetUpdatingPauseTimePercent=5",
        "-XX:SurvivorRatio=32",
        "-XX:+PerfDisableSharedMem",
        "-XX:MaxTenuringThreshold=1"
      ],
      "recommendedFor": [
        "paper",
        "purpur",
        "spigot"
      ]
    },
    {
      "id": "g1-basic",
      "label": "G1GC basic",
      "description": "Light, safe G1 tuning for modded and vanilla servers (Fabric, Forge, NeoForge, Vanilla).",
      "flags": [
        "-XX:+UseG1GC",
        "-XX:+ParallelRefProcEnabled",
        "-XX:MaxGCPauseMillis=200",
        "-XX:+DisableExplicitGC"
      ],
      "recommendedFor": [
        "fabric",
        "forge",
        "neoforge",
        "vanilla"
      ]
    },
    {
      "id": "zgc",
      "label": "Generational ZGC",
      "description": "Very low pause times on large heaps. Needs Java 21 or newer.",
      "flags": [
        "-XX:+UseZGC",
        "-XX:+ZGenerational"
      ]
    },
    {
      "id": "java23-unsafe",
      "label": "Silence Unsafe warning",
      "description": "Hides the \"sun.misc.Unsafe::objectFieldOffset\" deprecation warning printed by JOML on Java 23+. Do not use on older Java: it will not start.",
      "flags": [
        "--sun-misc-unsafe-memory-access=allow"
      ]
    }
  ],
  "modSources": [
    {
      "id": "modrinth",
      "name": "Modrinth",
      "type": "modrinth",
      "baseUrl": "https://api.modrinth.com/v2",
      "projectUrl": "https://modrinth.com/project/{slug}",
      "loaderCategories": {
        "fabric": [
          "fabric"
        ],
        "forge": [
          "forge"
        ],
        "neoforge": [
          "neoforge"
        ],
        "paper": [
          "paper",
          "spigot",
          "bukkit"
        ],
        "purpur": [
          "purpur",
          "paper",
          "spigot",
          "bukkit"
        ],
        "spigot": [
          "spigot",
          "bukkit"
        ]
      },
      "installDir": {
        "paper": "plugins",
        "purpur": "plugins",
        "spigot": "plugins"
      },
      "defaultInstallDir": "mods"
    }
  ],
  "logo": "logo.svg",
  "extension": "minecraft",
  "playerPanel": "minecraft-players",
  "playerView": {
    "dimensions": true,
    "coordinates": true,
    "vitals": true,
    "avatarUrl": "https://mc-heads.net/avatar/{{player}}/40"
  },
  "quickCommands": [
    {
      "label": "weather clear",
      "command": "weather clear"
    },
    {
      "label": "time set day",
      "command": "time set day"
    },
    {
      "label": "save-all",
      "command": "save-all"
    },
    {
      "label": "list",
      "command": "list"
    }
  ],
  "playerActions": [
    {
      "id": "kick",
      "label": {
        "en": "Kick",
        "es": "Expulsar"
      },
      "command": "kick {{player}} {{reason}}",
      "params": [
        {
          "id": "reason",
          "label": {
            "en": "Reason",
            "es": "Motivo"
          },
          "type": "text",
          "default": "Kicked by administrator"
        }
      ]
    },
    {
      "id": "ban",
      "label": {
        "en": "Ban",
        "es": "Banear"
      },
      "command": "ban {{player}} {{reason}}",
      "danger": true,
      "params": [
        {
          "id": "reason",
          "label": {
            "en": "Reason",
            "es": "Motivo"
          },
          "type": "text",
          "default": "Banned by administrator"
        }
      ]
    },
    {
      "id": "op",
      "label": {
        "en": "Make operator",
        "es": "Dar OP"
      },
      "command": "op {{player}}"
    },
    {
      "id": "deop",
      "label": {
        "en": "Remove operator",
        "es": "Quitar OP"
      },
      "command": "deop {{player}}"
    },
    {
      "id": "gamemode",
      "label": {
        "en": "Game mode",
        "es": "Modo de juego"
      },
      "command": "gamemode {{mode}} {{player}}",
      "params": [
        {
          "id": "mode",
          "label": {
            "en": "Mode",
            "es": "Modo"
          },
          "type": "select",
          "default": "survival",
          "options": [
            {
              "value": "survival",
              "label": {
                "en": "Survival",
                "es": "Supervivencia"
              }
            },
            {
              "value": "creative",
              "label": {
                "en": "Creative",
                "es": "Creativo"
              }
            },
            {
              "value": "adventure",
              "label": {
                "en": "Adventure",
                "es": "Aventura"
              }
            },
            {
              "value": "spectator",
              "label": {
                "en": "Spectator",
                "es": "Espectador"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "tp",
      "label": {
        "en": "Teleport",
        "es": "Teletransportar"
      },
      "command": "tp {{player}} {{x}} {{y}} {{z}}",
      "params": [
        {
          "id": "x",
          "label": {
            "en": "X",
            "es": "X"
          },
          "type": "number",
          "default": 0
        },
        {
          "id": "y",
          "label": {
            "en": "Y",
            "es": "Y"
          },
          "type": "number",
          "default": 64
        },
        {
          "id": "z",
          "label": {
            "en": "Z",
            "es": "Z"
          },
          "type": "number",
          "default": 0
        }
      ]
    },
    {
      "id": "give",
      "label": {
        "en": "Give item",
        "es": "Dar objeto"
      },
      "command": "give {{player}} {{item}} {{count}}",
      "params": [
        {
          "id": "item",
          "label": {
            "en": "Item id",
            "es": "ID del objeto"
          },
          "type": "text",
          "default": "minecraft:diamond"
        },
        {
          "id": "count",
          "label": {
            "en": "Count",
            "es": "Cantidad"
          },
          "type": "number",
          "default": 1
        }
      ]
    },
    {
      "id": "heal",
      "label": {
        "en": "Heal",
        "es": "Curar"
      },
      "command": "effect give {{player}} minecraft:instant_health 1 10"
    },
    {
      "id": "kill",
      "label": {
        "en": "Kill",
        "es": "Matar"
      },
      "command": "kill {{player}}",
      "danger": true
    },
    {
      "id": "clear",
      "label": {
        "en": "Clear inventory",
        "es": "Limpiar inventario"
      },
      "command": "clear {{player}}",
      "danger": true
    }
  ],
  "creationSettings": [
    {
      "id": "gamemode",
      "label": {
        "en": "Game mode",
        "es": "Modo de juego"
      },
      "type": "select",
      "file": "server.properties",
      "key": "gamemode",
      "default": "survival",
      "options": [
        {
          "value": "survival",
          "label": {
            "en": "Survival",
            "es": "Supervivencia"
          }
        },
        {
          "value": "creative",
          "label": {
            "en": "Creative",
            "es": "Creativo"
          }
        },
        {
          "value": "adventure",
          "label": {
            "en": "Adventure",
            "es": "Aventura"
          }
        },
        {
          "value": "spectator",
          "label": {
            "en": "Spectator",
            "es": "Espectador"
          }
        }
      ]
    },
    {
      "id": "difficulty",
      "label": {
        "en": "Difficulty",
        "es": "Dificultad"
      },
      "type": "select",
      "file": "server.properties",
      "key": "difficulty",
      "default": "normal",
      "options": [
        {
          "value": "peaceful",
          "label": {
            "en": "Peaceful",
            "es": "Pacífico"
          }
        },
        {
          "value": "easy",
          "label": {
            "en": "Easy",
            "es": "Fácil"
          }
        },
        {
          "value": "normal",
          "label": {
            "en": "Normal",
            "es": "Normal"
          }
        },
        {
          "value": "hard",
          "label": {
            "en": "Hard",
            "es": "Difícil"
          }
        }
      ]
    }
  ],
  "default": true,
  "instanceFolders": [
    "mods",
    "config"
  ],
  "modLayout": {
    "modsDir": "mods",
    "configDir": "config"
  },
  "bridgeTargets": {
    "paper": {
      "dir": "plugins",
      "asset": "mc-nexus-bridge-paper.jar"
    },
    "purpur": {
      "dir": "plugins",
      "asset": "mc-nexus-bridge-paper.jar"
    },
    "spigot": {
      "dir": "plugins",
      "asset": "mc-nexus-bridge-paper.jar"
    },
    "default": {
      "dir": "mods",
      "asset": "mc-nexus-bridge-fabric.jar"
    }
  }
}
